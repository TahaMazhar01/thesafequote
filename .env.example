# Local setup: npm run db:local creates .env.local with random credentials.
# Production: supply these values securely through your server environment.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-at-least-48-random-characters
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
# This limit applies PER Node.js process. Size against the DB connection budget.
DB_POOL_MAX=5
# Only set when a trusted reverse proxy overwrites this header and direct access
# to the application server is blocked. Leave blank for local development.
TRUSTED_IP_HEADER=
# Optional persistent directory for uploaded blog images.
# BLOG_UPLOAD_DIR=D:/app-data/thesafequote/blog-media
# Runtime TLS: required for a remote production database.
# DB_TLS=verify
# DB_CA_PEM=-----BEGIN CERTIFICATE-----...
# Migration/maintenance login must never be supplied to the web runtime in production.
# MIGRATION_DATABASE_URL=postgresql://MIGRATOR:PASSWORD@PRIVATE_HOST/DATABASE

# Staging environments must set this false. Production HTTPS defaults to indexable.
SITE_INDEXABLE=false
ADMIN_TIMEZONE=Asia/Karachi
# Persistent upload storage budget (bytes).
BLOG_STORAGE_MAX_BYTES=536870912
